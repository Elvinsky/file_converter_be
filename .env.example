# Root-level environment for `docker compose up --build`.
# Copy this file to `.env` (same directory) before running docker compose.
# These values mirror file-converter-server/.env.example and are used to
# configure all three services (postgres, backend, frontend) consistently.

# ---- Backend (file-converter-server) ----
NODE_ENV=production
COOKIE_SECRET=my-secret

# Port the backend listens on and is published on the host.
PORT=3007

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# ---- Database (PostgreSQL) ----
# POSTGRES_HOST is intentionally not listed here: within docker compose the
# backend always connects to the `postgres` service by its service name.
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Redis
# REDIS_HOST is set to `redis` inside docker compose; use localhost when running the server locally.
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Gmail SMTP (https://support.google.com/mail/answer/7126229)
# 1. Enable 2-Step Verification on your Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use your Gmail address for SMTP_USER and the 16-char App Password for SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM="File Converter <your@gmail.com>"

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Frontend (file-converter-app) ----
# Port the frontend listens on and is published on the host.
FRONTEND_PORT=3000
