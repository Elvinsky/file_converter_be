# Root-level environment for `docker compose up --build`.
# Copy this file to `.env` (same directory) before running docker compose.
# These values mirror file-converter-server/.env.example and are used to
# configure postgres and backend consistently.

# ---- Backend (file-converter-server) ----
NODE_ENV=production
COOKIE_SECRET=my-secret

# Port the backend listens on and is published on the host.
PORT=3007

# Health check
HEALTH_CHECK_ENABLED=false

# OpenAPI / Swagger UI at /docs (served by the backend)
SWAGGER_ENABLED=true

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# ---- Database (PostgreSQL) ----
# POSTGRES_HOST is intentionally not listed here: within docker compose the
# backend always connects to the `postgres` service by its service name.
# POSTGRES_PORT is the in-container / app port (always 5432 in compose).
POSTGRES_PORT=5432
# Optional preferred host publish port. Prefer `./scripts/compose-up.sh`, which
# keeps this value when free and auto-bumps if the port is already allocated.
# POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true
ADMINER_PORT=8080

# Redis (not run in docker compose for now; required by backend config validation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Gmail SMTP (https://support.google.com/mail/answer/7126229)
# 1. Enable 2-Step Verification on your Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use your Gmail address for SMTP_USER and the 16-char App Password for SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM="File Converter <your@gmail.com>"

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_TOKEN_EXPIRES_IN=30d


# Seeded admin user (initial migration)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ---- Object storage (MinIO / S3) ----
# S3_ENDPOINT is overridden to http://minio:9000 for the backend container.
# From the host (npm run start:dev) use http://localhost:9000 (or the
# remapped MINIO_API_HOST_PORT from .env.docker.ports).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=file-converter-dev
S3_FORCE_PATH_STYLE=true

# Multipart / text conversion
# Global Fastify upload ceiling (bytes). Default 10 MiB; max 100 MiB.
# Per-format convert caps must be ≤ MULTIPART_MAX_FILE_BYTES.
MULTIPART_MAX_FILE_BYTES=10485760
CONVERT_MAX_UPLOAD_CSV_BYTES=10485760
CONVERT_MAX_UPLOAD_JSON_BYTES=10485760
CONVERT_MAX_UPLOAD_XML_BYTES=10485760
CONVERT_MAX_UPLOAD_YAML_BYTES=10485760
# Worker conversion timeout (ms): 1000–120000
CONVERT_TIMEOUT_MS=30000
# Nesting / size attack limits
CONVERT_MAX_DEPTH=32
CONVERT_MAX_KEYS=10000
CONVERT_MAX_CSV_ROWS=100000
CONVERT_YAML_MAX_ALIASES=100
CONVERT_WORKER_POOL_SIZE=2
# Reserved for image conversion (not implemented yet)
CONVERT_MAX_UPLOAD_IMAGE_BYTES=10485760
CONVERT_IMAGE_MAX_WIDTH=8192
CONVERT_IMAGE_MAX_HEIGHT=8192
CONVERT_IMAGE_MAX_PIXELS=16777216
CONVERT_IMAGE_QUALITY_DEFAULT=80
# Optional preferred host publish ports. Prefer `./scripts/compose-up.sh`.
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
