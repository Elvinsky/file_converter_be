# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# OpenAPI / Swagger UI at /docs
SWAGGER_ENABLED=true

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true
ADMINER_PORT=8080

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Gmail SMTP (https://support.google.com/mail/answer/7126229)
# 1. Enable 2-Step Verification on your Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use your Gmail address for SMTP_USER and the 16-char App Password for SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM="File Converter <your@gmail.com>"

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# Seeded admin user (initial migration)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Object storage (MinIO locally — S3-compatible; no MinIO-specific app code)
# Run MinIO via root `./scripts/compose-up.sh` and point at localhost.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=file-converter-dev
S3_FORCE_PATH_STYLE=true

# Global Fastify upload ceiling (bytes). Default 10 MiB; max 100 MiB.
MULTIPART_MAX_FILE_BYTES=10485760
CONVERT_MAX_UPLOAD_CSV_BYTES=10485760
CONVERT_MAX_UPLOAD_JSON_BYTES=10485760
CONVERT_MAX_UPLOAD_XML_BYTES=10485760
CONVERT_MAX_UPLOAD_YAML_BYTES=10485760
# Worker conversion timeout (ms): 1000–120000
CONVERT_TIMEOUT_MS=30000
# Nesting / size attack limits
CONVERT_MAX_DEPTH=32
CONVERT_MAX_KEYS=10000
CONVERT_MAX_CSV_ROWS=100000
CONVERT_YAML_MAX_ALIASES=100
CONVERT_WORKER_POOL_SIZE=2
# Reserved for image conversion (not implemented yet)
CONVERT_MAX_UPLOAD_IMAGE_BYTES=10485760
CONVERT_IMAGE_MAX_WIDTH=8192
CONVERT_IMAGE_MAX_HEIGHT=8192
CONVERT_IMAGE_MAX_PIXELS=16777216
CONVERT_IMAGE_QUALITY_DEFAULT=80
