# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Mailtrap Email Sending (https://mailtrap.io)
# Create an API token at https://mailtrap.io/api-tokens (Admin access).
# View sent emails at https://mailtrap.io/sending/email_logs
MAILTRAP_TOKEN=
# Sender address must belong to a verified Mailtrap sending domain.
SMTP_FROM="File Converter <noreply@yourdomain.com>"

# Legacy SMTP settings (unused when sending via MailtrapTransport + MAILTRAP_TOKEN)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
