commit_msg_file="$1"
first_line=$(head -n1 "$commit_msg_file")

case "$first_line" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

if ! echo "$first_line" | grep -qE '^(feat|fix|doc|refactor): .+'; then
  echo "Invalid commit message: \"$first_line\""
  echo "Commit messages must start with one of:"
  echo "  feat: "
  echo "  fix: "
  echo "  doc: "
  echo "  refactor: "
  echo "Example: feat: add role assignment endpoint"
  exit 1
fi
